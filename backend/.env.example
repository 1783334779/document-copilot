# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Connect → Direct connection or Session pooler

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + direct DB access) ---

# Use Direct connection (db.<ref>.supabase.co:5432), or Session pooler for IPv4
# (postgres.<ref>@<pooler-host>:5432). Copy the full URI from Dashboard → Connect.
# Do NOT use Transaction pooler (port 6543) — migrations require a session connection.
# Replace the entire [YOUR-PASSWORD] placeholder, including the square brackets.
# Use the database password chosen at project creation, and URL-encode special characters.

DATABASE_URL=postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres

# --- Chat (DeepSeek, accessed through the OpenAI-compatible SDK) ---

OPENAI_API_KEY=your-deepseek-api-key
OPENAI_BASE_URL=https://api.deepseek.com
OPENAI_CHAT_MODEL=deepseek-flash
OPENAI_GROUNDING_MODEL=deepseek-flash
OPENAI_AGENT_REQUEST_LIMIT=20
OPENAI_AGENT_TEMPERATURE=0

# --- Embeddings (Alibaba Cloud Model Studio / DashScope) ---
# Copy the endpoint for the same workspace/region as your embedding API key.
# The SDK requires float responses; text-embedding-v4 allows at most 10 inputs per call.
# Document ingestion and live queries must use the same model and dimensions.
EMBEDDING_API_KEY=your-dashscope-api-key
EMBEDDING_BASE_URL=https://your-workspace-id.cn-beijing.maas.aliyuncs.com/compatible-mode/v1
EMBEDDING_MODEL=text-embedding-v4
EMBEDDING_DIMENSIONS=1536
EMBEDDING_BATCH_SIZE=10

# --- Retrieval (hybrid search defaults) ---

RETRIEVAL_CANDIDATE_K=50
RETRIEVAL_TOP_K=10
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOR_RADIUS=1
RETRIEVAL_FTS_CONFIG=english
RETRIEVAL_FTS_KEYWORD_MODEL=deepseek-flash
RETRIEVAL_FTS_KEYWORD_MIN=3
RETRIEVAL_FTS_KEYWORD_MAX=5
RETRIEVAL_FTS_KEYWORD_FAST_PATH_TOKENS=5

# --- Server ---

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173
