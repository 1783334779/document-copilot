# Address and port published by Docker on the host.
APP_BIND_ADDRESS=127.0.0.1
APP_PORT=8000

# Public frontend values. Keep backend credentials in backend/.env.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-publishable-key

# Optional override for the backend credentials file.
# BACKEND_ENV_FILE=./backend/.env
